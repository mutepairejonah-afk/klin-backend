PORT=3000
SUPABASE_URL=https://kynkpkhanabcxhjeqovh.supabase.co
SUPABASE_ANON_KEY=
# Server-only. Supabase dashboard -> Project Settings -> API -> service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=https://klin-web.onrender.com
CORS_ORIGIN=https://klin-web.onrender.com

# AI providers (free tiers). Tried in order; a 429/error falls through to the next.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
# gemini-2.5-flash is retired for new users. If the model here 404s the server
# automatically tries gemini-3.8-flash, 3.6-flash, then 3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash

# Ollama Cloud (free tier available). Get a key at ollama.com/settings/keys.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
# Default order is google,openrouter,ollama,anthropic. Override with e.g.:
# PROVIDER_ORDER=google,openrouter

# Optional, paid. Tried last by default (after the free providers above).
# Get a key at console.anthropic.com. Uses api.anthropic.com/v1/messages directly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Clerk (auth). Get from dashboard.clerk.com -> API Keys.
CLERK_SECRET_KEY=

# Reversible encryption key for connector OAuth tokens (32+ random bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENC_KEY=

# GitHub OAuth App (github.com/settings/developers -> New OAuth App).
# Callback URL must be: <BACKEND_URL>/api/connections/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Only needed if this isn't inferable from the request (e.g. behind a proxy).
BACKEND_URL=https://kiln-api-ezfp.onrender.com

# Execution plane. Disabled by default; enable only on a host with Docker and
# a pinned sandbox image. Network none is the safe default. Use a pre-created
# policy-controlled Docker network only for jobs that need package/Git access.
# Sandbox provider: docker (default) or daytona.
KILN_SANDBOX_PROVIDER=docker
KILN_EXECUTION_ENABLED=false
ORCHESTRATOR_MODE=coding
KILN_SANDBOX_IMAGE=ghcr.io/mutepairejonah-afk/klin-sandbox:node20-python311
KILN_SANDBOX_NETWORK=none
KILN_SANDBOX_CPUS=2
KILN_SANDBOX_MEMORY=2g
KILN_SANDBOX_PIDS_LIMIT=256
KILN_WORKER_CONCURRENCY=2
KILN_KEEP_SANDBOX=false
ALLOW_DEV_SANDBOX_EXEC=false

# Daytona (used when KILN_SANDBOX_PROVIDER=daytona). Create a key at app.daytona.io -> API Keys.
# Set the key only in your host's secret/env settings (e.g. Render env vars), never in git or chat.
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# Preferred: a snapshot that has git, ripgrep, node and python. Falls back to DAYTONA_IMAGE, then Daytona's default.
# DAYTONA_SNAPSHOT=
# DAYTONA_IMAGE=
# DAYTONA_AUTO_STOP_MINUTES=30
# DAYTONA_MEMORY_GB=2
# Comma-separated CIDRs; only applies when KILN_SANDBOX_NETWORK is not "none".
# DAYTONA_NETWORK_ALLOW_LIST=
