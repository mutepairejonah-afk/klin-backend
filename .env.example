PORT=3000
SUPABASE_URL=https://kynkpkhanabcxhjeqovh.supabase.co
SUPABASE_ANON_KEY=
# Server-only. Supabase dashboard -> Project Settings -> API -> service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=https://klin-web.onrender.com
CORS_ORIGIN=https://klin-web.onrender.com

# AI providers (free tiers). Tried in order; a 429/error falls through to the next.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Cloud (free tier available). Get a key at ollama.com/settings/keys.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
# PROVIDER_ORDER=google,openrouter

# Optional, paid. Tried last by default (after the free providers above).
# Get a key at console.anthropic.com. Uses api.anthropic.com/v1/messages directly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Clerk (auth). Get from dashboard.clerk.com -> API Keys.
CLERK_SECRET_KEY=

# Reversible encryption key for connector OAuth tokens (32+ random bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENC_KEY=

# GitHub OAuth App (github.com/settings/developers -> New OAuth App).
# Callback URL must be: <BACKEND_URL>/api/connections/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Only needed if this isn't inferable from the request (e.g. behind a proxy).
BACKEND_URL=https://kiln-api-ezfp.onrender.com
